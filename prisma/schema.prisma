// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// provider stays "sqlite" — Turso is libSQL (SQLite-compatible).
// Migrations run against local file SQLite; the app uses Turso via driver adapter.
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Message {
  id        String   @id @default(cuid())
  name      String
  content   String
  createdAt DateTime @default(now())
}
